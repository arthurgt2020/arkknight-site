---
import Base from '../layouts/Base.astro';
import Tags from '../components/Tags.astro';
import RiskMatrix from '../components/RiskMatrix.astro';
import { getCollection } from 'astro:content';
import { fmt, published, byDropDesc } from '../utils';

const byDate = (a: any, b: any) => +b.data.date - +a.data.date;
const projects = (await getCollection('projects')).filter((p) => p.data.featured).sort(byDate).slice(0, 3);
const intel = (await getCollection('intel', published)).sort(byDropDesc).slice(0, 3);
const latest = (await getCollection('intel', published)).sort(byDropDesc).find((i) => i.data.risk);
const hunts = (await getCollection('hunts', published)).sort(byDropDesc).slice(0, 3);
---
<Base>
  <div class="hero">
    <div>
      <p class="eyebrow">Threat intelligence, threat hunting and automation</p>
      <h1>Arthur T.</h1>
      <p class="lead">
        Senior Threat Intelligence Analyst based in the UAE. I track threat actors, build hunting content
        and automate security operations, and share what I learn through write-ups and the RedKuppi Series.
      </p>
      <p><a class="btn" href="/about/">About me</a></p>
    </div>
    {latest && (
      <a class="hero-latest" href={`/intel/${latest.id}/`}>
        <RiskMatrix likelihood={latest.data.risk.likelihood} impact={latest.data.risk.impact} />
        <p class="caption"><span>Latest Intel Drop, {fmt(latest.data.date)}</span>{latest.data.title.split('| ').pop()}</p>
      </a>
    )}
  </div>

  <section class="section">
    <div class="section-head"><h2>Featured projects</h2><a href="/projects/">All projects →</a></div>
    <div class="grid">
      {projects.map((p) => (
        <a class="card" href={`/projects/${p.id}/`}>
          <h3>{p.data.title}</h3>
          <p>{p.data.summary}</p>
          <Tags tags={p.data.stack} link={false} />
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head"><h2>Latest intelligence</h2><a href="/intel/">Intel →</a></div>
    {intel.length ? (
      <div class="grid">
        {intel.map((i) => (
          <a class="card" href={`/intel/${i.id}/`}>
            <span class="meta">{i.data.type} · {fmt(i.data.date)}</span>
            <h3>{i.data.title}</h3>
            <p>{i.data.summary}</p>
            <Tags attack={i.data.attack} link={false} />
          </a>
        ))}
      </div>
    ) : <p class="empty">First intelligence write-ups coming soon.</p>}
  </section>

  <section class="section">
    <div class="section-head"><h2>Latest hunts</h2><a href="/hunting/">Hunting →</a></div>
    {hunts.length ? (
      <div class="grid">
        {hunts.map((h) => (
          <a class="card" href={`/hunting/${h.id}/`}>
            <span class="meta">{h.data.status} · {fmt(h.data.date)}</span>
            <h3>{h.data.title}</h3>
            <p>{h.data.hypothesis}</p>
            <Tags attack={h.data.attack} tags={h.data.languages} link={false} />
          </a>
        ))}
      </div>
    ) : <p class="empty">First hunting queries coming soon.</p>}
  </section>
</Base>
