---
import Base from '../../layouts/Base.astro';
import RiskMatrix from '../../components/RiskMatrix.astro';
import Tags from '../../components/Tags.astro';
import { getCollection, render } from 'astro:content';
import { fmt, published } from '../../utils';

export async function getStaticPaths() {
  const items = await getCollection('intel', published);
  return items.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props as any;
const { Content } = await render(entry);
const d = entry.data;
---
<Base title={d.title} description={d.summary ?? d.description ?? d.hypothesis}>
  <article class="prose">
    <p class="eyebrow"><a href="/intel/">← intel</a></p>
    <div class={d.risk ? 'with-matrix' : undefined}>
      <div>
        <h1>{d.title}</h1>
        <p class="meta">{d.type} · TLP:{d.tlp} · {fmt(d.date)}{d.actor && ` · ${d.actor}`}</p>
        <Tags attack={d.attack} tags={d.tags ?? d.languages ?? d.stack} />
      </div>
      {d.risk && <RiskMatrix likelihood={d.risk.likelihood} impact={d.risk.impact} compact />}
    </div>
    <Content />
  </article>
</Base>
