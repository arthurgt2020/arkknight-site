---
import Base from '../../layouts/Base.astro';
import Tags from '../../components/Tags.astro';
import { getCollection } from 'astro:content';
import { fmt, published } from '../../utils';
const items = (await getCollection('intel', published)).sort((a: any, b: any) => +b.data.date - +a.data.date);
---
<Base title="Threat Intelligence" description="Threat actor profiles, campaign analysis and advisories, mapped to MITRE ATT&CK. Shared at TLP:CLEAR.">
  <p class="eyebrow">Threat Intelligence</p>
  <h1>Threat Intelligence</h1>
  <p class="lead">Threat actor profiles, campaign analysis and advisories, mapped to MITRE ATT&CK. Shared at TLP:CLEAR.</p>
  <section class="section">
    {items.length ? (
      <div class="grid">
        {items.map((i: any) => (
          <a class="card" href={`/intel/${i.id}/`}>
            <span class="meta">{i.data.type} · {fmt(i.data.date)}</span>
            <h3>{i.data.title}</h3>
            <p>{i.data.summary}</p>
            <Tags attack={i.data.attack} tags={i.data.tags ?? i.data.languages ?? i.data.stack} />
          </a>
        ))}
      </div>
    ) : <p class="empty">Nothing published yet. Check back soon.</p>}
  </section>
</Base>
