---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { fmt, published } from '../../utils';
const items = (await getCollection('research', published)).sort((a, b) => +b.data.date - +a.data.date);
---
<Base title="Threat Actor Research" description="Threat actor research and tracking. Shared at TLP:CLEAR.">
  <p class="eyebrow">Actor Research</p>
  <h1>Threat Actor Research</h1>
  <p class="lead">Research on emerging threat actors. Claims are labelled as claims. Shared at TLP:CLEAR.</p>
  <section class="section">
    {items.length ? (
      <div class="grid">
        {items.map((i) => (
          <a class="card" href={`/research/${i.id}/`}>
            <span class="meta">{i.data.actor} · {fmt(i.data.date)}{i.data.claimsUnverified && ' · Claims unverified'}</span>
            <h3>{i.data.title}</h3>
            <p>{i.data.summary}</p>
          </a>
        ))}
      </div>
    ) : <p class="empty">Nothing published yet. Check back soon.</p>}
  </section>
</Base>
