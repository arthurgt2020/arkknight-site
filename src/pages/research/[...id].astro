---
import Base from '../../layouts/Base.astro';
import Tags from '../../components/Tags.astro';
import { getCollection, render } from 'astro:content';
import { fmt, published } from '../../utils';

export async function getStaticPaths() {
  const items = await getCollection('research', published);
  return items.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props as any;
const { Content } = await render(entry);
const d = entry.data;
---
<Base title={d.title} description={d.summary}>
  <article class="prose">
    <p class="eyebrow"><a href="/research/">← actor research</a></p>
    <h1>{d.title}</h1>
    <p class="meta">{d.actor} · TLP:{d.tlp} · {fmt(d.date)}{d.claimsUnverified && ' · Claims unverified'}</p>
    <Tags attack={d.attack} tags={[]} />
    <Content />
    {d.linkedinUrl && <p><a href={d.linkedinUrl} target="_blank" rel="noopener">View on LinkedIn →</a></p>}
  </article>
</Base>
