---
import Base from '../../layouts/Base.astro';
import Tags from '../../components/Tags.astro';
import { getCollection } from 'astro:content';
import { fmt, published } from '../../utils';
const items = (await getCollection('posts', published)).sort((a: any, b: any) => +b.data.date - +a.data.date);
---
<Base title="Blog" description="Write-ups on cyber security, threat intelligence and AI.">
  <p class="eyebrow">Blog</p>
  <h1>Blog</h1>
  <p class="lead">Write-ups on cyber security, threat intelligence and AI.</p>
  <section class="section">
    {items.length ? (
      <div class="grid">
        {items.map((i: any) => (
          <a class="card" href={`/blog/${i.id}/`}>
            <span class="meta">{fmt(i.data.date)}</span>
            <h3>{i.data.title}</h3>
            <p>{i.data.description}</p>
            <Tags attack={i.data.attack} tags={i.data.tags ?? i.data.languages ?? i.data.stack} />
          </a>
        ))}
      </div>
    ) : <p class="empty">Nothing published yet. Check back soon.</p>}
  </section>
</Base>
