---
import Base from '../../layouts/Base.astro';
import Tags from '../../components/Tags.astro';
import { getCollection } from 'astro:content';
import { fmt, published, byDropDesc } from '../../utils';
const items = (await getCollection('hunts', published)).sort(byDropDesc);
---
<Base title="Threat Hunting" description="Hypothesis-driven hunts with queries in KQL, SPL and Sigma. Full query library on GitHub.">
  <p class="eyebrow">Threat Hunting</p>
  <h1>Threat Hunting</h1>
  <p class="lead">Hypothesis-driven hunts with queries in KQL, SPL and Sigma. Full query library on GitHub.</p>
  <section class="section">
    {items.length ? (
      <div class="grid">
        {items.map((i: any) => (
          <a class="card" href={`/hunting/${i.id}/`}>
            <span class="meta">{i.data.status} · {fmt(i.data.date)}</span>
            <h3>{i.data.title}</h3>
            <p>{i.data.hypothesis}</p>
            <Tags attack={i.data.attack} tags={i.data.tags ?? i.data.languages ?? i.data.stack} link={false} />
          </a>
        ))}
      </div>
    ) : <p class="empty">Nothing published yet. Check back soon.</p>}
  </section>
</Base>
